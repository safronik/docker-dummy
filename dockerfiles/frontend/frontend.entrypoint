#!/bin/sh
set -e

FRONTEND_USER=node
if [ -n "$APP_UID" ] && [ -n "$APP_GID" ] && id "$FRONTEND_USER" >/dev/null 2>&1; then
    usermod  -o -u "$APP_UID" "$FRONTEND_USER"
    groupmod -o -g "$APP_GID" "$FRONTEND_USER"
fi

case "$ENV_STAGE" in

    # No frontend installed. Performing installation
    blank|dev)
        if [ ! -f package.json ]; then
            TMP_CREATION_DIR=/tmp/node
            WORK_DIR=$(pwd)
            rm -rf "$TMP_CREATION_DIR"
            mkdir "$TMP_CREATION_DIR"
            cd "$TMP_CREATION_DIR"
            npm create -y vue@3.22.4 frontend -- --ts --router --pinia --eslint
            cp -a "$TMP_CREATION_DIR"/. "$WORK_DIR"
            cd "$WORK_DIR"
            rm -rf "$TMP_CREATION_DIR"
            npm pkg set scripts.dev="vite --host 0.0.0.0"
        fi
        [ -d node_modules ] || npm install
        ;;

    # Fatal error if code is empty. It should be already provided by installation script
    prod|test)
        [ -f package.json ] || {
            echo "FATAL: no frontend code in $(pwd) (ENV_STAGE=$ENV_STAGE)" >&2
            exit 1
        }
        ;;
esac

exec gosu "$FRONTEND_USER" "$@"
