# Кодировки и переводы строк для редакторов.
# Переводы строк продублированы из .gitattributes — держать их согласованными.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Windows PowerShell 5.1 читает .ps1 без BOM в системной ANSI-кодировке и не может
# разобрать файл с не-ASCII символами. BOM обязателен, см. .gitattributes.
[*.ps1]
charset = utf-8-bom
end_of_line = crlf

# BOM здесь, наоборот, запрещён: ломает `@echo off` в cmd.exe.
[*.{cmd,bat}]
charset = utf-8
end_of_line = crlf

[Makefile]
indent_style = tab
