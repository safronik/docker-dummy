COMPOSE_PROFILES={COMPOSE_PROFILES}
HOST_UID=1000
HOST_GID=1000
ENV_STAGE={ENV_STAGE}
PROJECT_NAME={PROJECT_NAME}
PROJECT_DOMAIN={PROJECT_DOMAIN}
# Адрес для ACME-аккаунта Let's Encrypt и писем об истечении сертификата.
# Заполняется установщиком только на стадиях prod/test; на blank/dev остаётся пустым.
SSL_EMAIL={SSL_EMAIL}
XDEBUG_REMOTE_PORT={XDEBUG_REMOTE_PORT}
NODE_EXTERNAL_PORT={NODE_EXTERNAL_PORT}
# Единственный источник пароля БД. Из него собираются и переменные сервера СУБД,
# и DATABASE_URL приложения (см. docker-compose.yml). Не дублировать в .env.<stage>.
DB_PASSWORD={DB_PASSWORD}
DB_PORT={DB_PORT}
DB_DOCKERFILE={DB_DOCKERFILE}
DB_DATA_VOLUME={DB_DATA_VOLUME}
DB_PORT_INTERNAL={DB_PORT_INTERNAL}
DB_COMMAND={DB_COMMAND}
DB_SCHEME={DB_SCHEME}
DB_CHARSET={DB_CHARSET}
